# CI lab VM -> hypervisor map. Copy to ci/lab.env (gitignored) for local runs,
# or set the same names as repository variables (CI_SINGLE_VMS / CI_HA_VMS) for
# manual e2e runs. Each entry is vm@hypervisor; the hypervisor is reached as
# linux@<address> with ~/.ssh/id_ed25519.
#
# The addresses below are documentation placeholders (TEST-NET-1).
CI_SINGLE_VMS="single-node@192.0.2.2"
CI_HA_VMS="ha-node-1@192.0.2.6 ha-node-2@192.0.2.2 ha-node-3@192.0.2.3"
