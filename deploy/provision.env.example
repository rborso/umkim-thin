# Provisioning inputs. Copy to `deploy/provision.env` (gitignored) and edit.
# Everything here is environment-specific; the Ansible roles stay generic.
# The addresses below are documentation placeholders, not a working lab.

# --- connection ---
# The runner ships the playbook to JUMP, which must be able to reach VHOST
# directly (the jumphost holds the key the guest trusts).
JUMP=linux@jump.example.com
JUMP_PORT=22
VSSH_KEY=$HOME/.ssh/id_ed25519
VHOST=192.0.2.10
VUSER=linux
REMOTE_WORKDIR=/home/linux/umkim-thin-deploy

# The cluster's servers, primary first. One host = single node; three = HA
# (embedded etcd). Each must be reachable from JUMP with the key above.
servers="192.0.2.10"

# --- site ---
zone=example.com
portal_host=auth.example.com
console_host=console.example.com
base_dn=dc=example,dc=com
admin_email=admin@example.com
acme_email=admin@example.com

# --- published (external NAT) -> internal (host) ---
pub_web=80
pub_tls=443
pub_wg=51820
web_nodeport=30080
tls_nodeport=30443
wg_port=51820

# --- cluster networks ---
pod_cidr=10.244.0.0/16
service_cidr=10.43.0.0/16
# Your node/management network: the API, NFS and WireGuard trust follow it.
lab_cidr=192.0.2.0/24

# --- k3s ---
k3s_channel=stable
# Pin a version, e.g. v1.31.5+k3s1; empty uses the channel's current release.
k3s_version=

# --- WireGuard ---
# wg_endpoint is the public address clients dial (the external NAT forwards the
# WireGuard UDP port to the node). Give the public DNS name, e.g.
# wg.example.com; the port is appended unless you include it. The console
# refuses to create a client while this is empty.
wg_endpoint=
wg_subnet=192.168.168.0/24
wg_server_ip=192.168.168.1

# --- app charts ---
# Optional out-of-tree charts, as "url:subdir" or "repo:subdir" pairs. They are
# cloned with the runner's Git credentials and packaged into the chart mirror.
# Leave empty to use the vendored charts under charts/apps/.
chart_repos=""

# --- GPU node (optional) ---
# Off by default: a normal install adds no vendor repository, builds no kernel
# module and reboots nothing. Set every key below on a host that has an NVIDIA
# card, in an environment that is EL10 (the role refuses anything else).
#
# The driver is installed BEFORE k3s and reboots the host, so the one outage this
# costs happens while there is no cluster and no app to take down. The device
# plugin is installed later, in the platform play.
#gpu_enabled=true
# "open" is Turing and newer only; Pascal and older need the proprietary module.
#gpu_driver_flavor=proprietary
# Pin the branch: a pre-Turing card is dropped by later branches, so "newest" is
# a driver that installs and then cannot drive the card.
#gpu_driver_version=580.196.07
# Set on an AI target whose backends should run on the card; ci/ai-check.sh then
# asserts the GPU contract instead of the CPU one.
#ai_gpu=true

# --- paths on the target ---
remote_dir=/opt/umkim-thin
state_dir=/etc/umkim-thin
