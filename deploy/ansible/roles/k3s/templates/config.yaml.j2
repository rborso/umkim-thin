write-kubeconfig-mode: "0600"
# Encrypt Secrets at rest in etcd. On a fresh cluster every Secret is written
# through the encryption provider; an existing cluster needs a restart and a
# re-encrypt pass (see `k3s secrets-encrypt status`). HA needs the same
# encryption key on every server; set secrets_encryption=false until the key
# distribution is automated (the current CI profile does this on HA).
{% if secrets_encryption | default(true) | bool %}
secrets-encryption: true
{% endif %}
# Large volume restores stream through the API; the default 60s request timeout
# kills the exec stream mid-extract. The client sets its own timeout. This is
# independent of secrets-encryption (HA runs with encryption off until the key
# distribution is automated, and must still keep the long request timeout).
kube-apiserver-arg:
  - "request-timeout=1h"
# Reclaim replaced image layers and protect the node before it wedges. The
# kubelet defaults (image GC at ~85% of the disk, no eviction) let a run of app
# upgrades keep every layer of every replaced tag: dev-single reached 51 GB of
# containerd images and ~400 MB of free RAM with no eviction policy.
kubelet-arg:
  - "image-gc-high-threshold=70"
  - "image-gc-low-threshold=60"
  - "eviction-hard=memory.available<200Mi,nodefs.available<10%,imagefs.available<15%"
  - "eviction-soft=memory.available<400Mi,nodefs.available<15%"
  - "eviction-soft-grace-period=memory.available=2m,nodefs.available=2m"
  - "eviction-max-pod-grace-period=60"
  - "system-reserved=cpu=100m,memory=256Mi"
  - "kube-reserved=cpu=100m,memory=256Mi"
node-name: {{ ansible_hostname }}
node-ip: {{ ansible_default_ipv4.address }}
advertise-address: {{ ansible_default_ipv4.address }}
# Calico is the CNI and the NetworkPolicy engine.
flannel-backend: none
disable-network-policy: true
# Align k3s's advertised ranges with the CNI (Calico's pool is pod_cidr).
cluster-cidr: {{ pod_cidr }}
service-cidr: {{ service_cidr }}
{% if k3s_effective_tls_san | length %}
tls-san:
{% for san in k3s_effective_tls_san %}
  - {{ san }}
{% endfor %}
{% endif %}
{% if k3s_multi %}
{% if inventory_hostname == k3s_primary %}
cluster-init: true
{% else %}
server: https://{{ k3s_join_target }}:6443
token: {{ k3s_effective_token }}
{% endif %}
{% endif %}
