# Console config. The console always runs cluster-style: mutable state lives on
# the PVC at /data, the kubeconfig is generated from the pod's ServiceAccount,
# and the chart mirror (including the identity chart) is seeded from a ConfigMap.
UMKIM_THIN_KUBECONFIG=/tmp/kubeconfig
UMKIM_THIN_STATE_DIR=/data
UMKIM_THIN_CHART_MIRROR=/data/chart-mirror
UMKIM_THIN_REMOTE_DIR={{ remote_dir }}
UMKIM_THIN_ZONE={{ zone }}
UMKIM_THIN_PORTAL_HOST={{ portal_host }}
UMKIM_THIN_TENANT={{ tenant | default('default-tenant') }}
UMKIM_THIN_STORAGE_CONFIG_CLASS={{ storage_class_config }}
UMKIM_THIN_STORAGE_MEDIA_CLASS={{ storage_class_media }}
UMKIM_THIN_STORAGE_MEDIA_ACCESS_MODE={{ storage_media_access_mode | default('ReadWriteMany') }}
UMKIM_THIN_SERVICE_CIDR={{ service_cidr }}
UMKIM_THIN_POD_CIDR={{ pod_cidr }}
UMKIM_THIN_DNS_IP={{ dns_service_ip | default('10.43.0.10') }}
UMKIM_THIN_MIDDLEWARE={{ middleware | default('identity-authelia@file') }}
UMKIM_THIN_IDENTITY_NAMESPACE=identity
UMKIM_THIN_IDENTITY_CHART=/data/chart-mirror/{{ identity_tgz.stdout | trim }}
UMKIM_THIN_IDENTITY_VALUES=/data/identity-values.yml
UMKIM_THIN_IDENTITY_APPS=/data/identity-apps.yml
UMKIM_THIN_BIND_SECRET=lldap-service-accounts
UMKIM_THIN_BASE_DN={{ base_dn }}
UMKIM_THIN_LLDAP_HOST=lldap.identity.svc.cluster.local
UMKIM_THIN_LLDAP_PORT=3890
UMKIM_THIN_HELM=/usr/local/bin/helm
UMKIM_THIN_KUBECTL=/usr/local/bin/kubectl
UMKIM_THIN_INVITES=/data/invites.json
UMKIM_THIN_WG_STATE=/data/wg-clients.json
UMKIM_THIN_APPS_STATE=/data/apps-state.json

# On-demand bootstrap: the console image carries the fixed build context, the
# builder runs on the first server and imports into that node's containerd.
UMKIM_THIN_CONSOLE_IMAGE=localhost/umkim-thin:dev
UMKIM_THIN_BOOTSTRAP_IMAGE=localhost/umkim-thin/servarr-bootstrap
UMKIM_THIN_BOOTSTRAP_CONTEXT=/opt/umkim-thin/bootstrap
UMKIM_THIN_BUILDER_IMAGE=gcr.io/kaniko-project/executor:v1.23.2-debug@sha256:fb6d29da5792b6b9886bb132d1bb600bec79a47a31e4c152df3e52de9c561a44
UMKIM_THIN_BUILD_NAMESPACE=umkim-thin-build
UMKIM_THIN_BOOTSTRAP_NODE={{ hostvars[groups['server'][0]].ansible_hostname | default('') }}

# Console login (its own session, independent of Authelia)
UMKIM_THIN_CONSOLE_ADMIN_USER=admin
UMKIM_THIN_CONSOLE_LOCAL_USER=localadmin
UMKIM_THIN_CONSOLE_LOCAL_PASSWORD_FILE=/data/console-localadmin-password
UMKIM_THIN_SECRETS_FILE=/data/secrets.yml
UMKIM_THIN_CONSOLE_SESSION_KEY_FILE=/data/console-session-key

# WireGuard gateway
UMKIM_THIN_WG_NAMESPACE=wireguard
UMKIM_THIN_WG_SECRET=wireguard-peers
UMKIM_THIN_WG_SUBNET={{ wg_subnet }}
UMKIM_THIN_WG_SERVER_IP={{ wg_server_ip }}
UMKIM_THIN_WG_PORT={{ wg_port }}
UMKIM_THIN_WG_ENDPOINT={{ wg_endpoint }}:{{ wg_port }}
UMKIM_THIN_WG_ALLOWED_IPS={{ pod_cidr }},{{ service_cidr }}
