apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    service:
      spec:
        # LoadBalancer lets k3s's servicelb bind 80/443 on every node; the VIP is
        # added as an externalIP so the HA address serves the standard ports too
        # (the explicit nodePorts remain for routers that DNAT to them).
        type: LoadBalancer
{% if k3s_control_plane_vip | default('') | length %}
        externalIPs:
          - {{ k3s_control_plane_vip }}
{% endif %}
    ports:
      web:
        nodePort: {{ web_nodeport }}
{% if external_proxy | default(false) | bool %}
        # Plain HTTP is the published path: a front proxy terminates TLS.
        allowACMEByPass: true
{% else %}
        # Send plain HTTP to HTTPS, but never redirect the ACME HTTP-01
        # challenge (or certificate issuance breaks).
        allowACMEByPass: true
        http:
          redirections:
            entryPoint:
              to: websecure
              scheme: https
              permanent: true
{% endif %}
      websecure:
        nodePort: {{ tls_nodeport }}
      vpn:
        # Internal entrypoint for WireGuard-only routes. The public router
        # forwards 80/443 only; the gateway DNATs tunnel :443 to this NodePort.
        port: 9443
        exposedPort: 9443
        nodePort: {{ vpn_nodeport | default(30444) }}
        protocol: TCP
        expose:
          default: true
      gitssh:
        # Git over SSH is raw TCP; a dedicated Traefik entry point forwards it to
        # Gitea's SSH Service. The HA VIP carries the service port; routers can
        # forward the public port to either the VIP or the NodePort.
        port: {{ pub_git | default(2222) }}
        exposedPort: {{ pub_git | default(2222) }}
        protocol: TCP
        nodePort: {{ git_nodeport | default(30222) }}
        expose:
          default: true
    additionalArguments:
{% if not external_proxy | default(false) | bool %}
      - "--certificatesresolvers.letsencrypt.acme.email={{ acme_email }}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/data/acme.json"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
{% if acme_staging | default(false) | bool %}
      # Certificate issuance for tests: use the Let's Encrypt staging directory
      # so runs never touch the 50 certs / 7 days production limit. Certs are
      # untrusted by browsers, which is fine for CI.
      - "--certificatesresolvers.letsencrypt.acme.caserver=https://acme-staging-v02.api.letsencrypt.org/directory"
{% endif %}
{% else %}
      # A front proxy terminates TLS, so Traefik must accept its
      # X-Forwarded-Proto / X-Forwarded-For. Without that, Authelia sees an
      # http target URL and rejects the forward-auth request as insecure.
      #
      # A NodePort address (Cluster traffic policy) is SNATed to the node the
      # request lands on, so a proxy that dials the VIP/NodePort usually shows
      # up as a node address rather than its own. List the addresses here when
      # they are stable; otherwise insecure=true is required, which is safe
      # only while the web entrypoint is reachable solely by the proxy.
{% if external_proxy_trusted_ips | default([]) | length %}
      - "--entryPoints.web.forwardedHeaders.trustedIPs={{ external_proxy_trusted_ips | join(',') }}"
      - "--entryPoints.websecure.forwardedHeaders.trustedIPs={{ external_proxy_trusted_ips | join(',') }}"
{% else %}
      - "--entryPoints.web.forwardedHeaders.insecure=true"
      - "--entryPoints.websecure.forwardedHeaders.insecure=true"
{% endif %}
{% endif %}
      - "--providers.file.directory=/etc/traefik/dynamic"
      - "--providers.file.watch=true"
    persistence:
      enabled: true
      path: /data
      size: 128Mi
      storageClass: {{ traefik_storage_class | default(storage_class_config) | quote }}
    volumes:
      # The middleware fragment the identity chart publishes; mounted as a
      # Traefik file provider so `identity-authelia@file` resolves.
      - name: identity-traefik
        mountPath: /etc/traefik/dynamic
        type: configMap
    # The /data volume (acme.json) is a Longhorn RWO volume on the HA target. Its
    # root is owned by root, and Traefik runs as 65532, so it could not create
    # acme.json ("permission denied") and the ACME resolver was skipped. fsGroup
    # makes the kubelet chown the volume for the pod.
    podSecurityContext:
      fsGroup: 65532
      fsGroupChangePolicy: OnRootMismatch
    # The HTTP-01 challenge reaches Traefik through the Service, and klipper-lb
    # rejects (RST -> "connection refused") while the pod has no ready endpoint.
    # The stock probe checks at 2s and then every 10s, leaving a ~14s hole after
    # a restart; ACME's startup attempt lands in it and never issues. Probe
    # quickly so the endpoint exists before the resolver runs.
    readinessProbe:
      initialDelaySeconds: 1
      periodSeconds: 2
      timeoutSeconds: 2
      failureThreshold: 1
    livenessProbe:
      initialDelaySeconds: 10
      periodSeconds: 10
      timeoutSeconds: 2
      failureThreshold: 3
    deployment:
      initContainers:
        - name: volume-permissions
          image: busybox:1.36
          command: ["sh", "-c", "touch /data/acme.json && chmod 600 /data/acme.json"]
          volumeMounts:
            - name: data
              mountPath: /data
    # Serve the locally-trusted wildcard as the default certificate (fallback
    # when ACME does not issue; import the CA into your browser to trust it).
    # A full run leaves this out so ACME is actually exercised - a default
    # certificate that matches the host makes Traefik skip the request.
{% if lab_ca_default | default(true) | bool %}
    tlsStore:
      default:
        defaultCertificate:
          secretName: umkim-thin-wildcard
{% endif %}
