apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    service:
      spec:
        # LoadBalancer lets k3s's servicelb bind 80/443 on every node; the VIP is
        # added as an externalIP so the HA address serves the standard ports too
        # (the explicit nodePorts remain for routers that DNAT to them).
        type: LoadBalancer
{% if k3s_control_plane_vip | default('') | length %}
        externalIPs:
          - {{ k3s_control_plane_vip }}
{% endif %}
    ports:
      web:
        nodePort: {{ web_nodeport }}
        # Send plain HTTP to HTTPS, but never redirect the ACME HTTP-01
        # challenge (or certificate issuance breaks).
        allowACMEByPass: true
        http:
          redirections:
            entryPoint:
              to: websecure
              scheme: https
              permanent: true
      websecure:
        nodePort: {{ tls_nodeport }}
      gitssh:
        # Git over SSH is raw TCP; a dedicated Traefik entry point forwards it to
        # Gitea's SSH Service. The HA VIP carries the service port; routers can
        # forward the public port to either the VIP or the NodePort.
        port: {{ pub_git | default(2222) }}
        exposedPort: {{ pub_git | default(2222) }}
        protocol: TCP
        nodePort: {{ git_nodeport | default(30222) }}
        expose:
          default: true
    additionalArguments:
      - "--certificatesresolvers.letsencrypt.acme.email={{ acme_email }}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/data/acme.json"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
{% if acme_staging | default(false) | bool %}
      # Certificate issuance for tests: use the Let's Encrypt staging directory
      # so runs never touch the 50 certs / 7 days production limit. Certs are
      # untrusted by browsers, which is fine for CI.
      - "--certificatesresolvers.letsencrypt.acme.caserver=https://acme-staging-v02.api.letsencrypt.org/directory"
{% endif %}
      - "--providers.file.directory=/etc/traefik/dynamic"
      - "--providers.file.watch=true"
    persistence:
      enabled: true
      path: /data
      size: 128Mi
      storageClass: {{ traefik_storage_class | default(storage_class_config) | quote }}
    volumes:
      # The middleware fragment the identity chart publishes; mounted as a
      # Traefik file provider so `identity-authelia@file` resolves.
      - name: identity-traefik
        mountPath: /etc/traefik/dynamic
        type: configMap
    # The /data volume (acme.json) is a Longhorn RWO volume on the HA target. Its
    # root is owned by root, and Traefik runs as 65532, so it could not create
    # acme.json ("permission denied") and the ACME resolver was skipped. fsGroup
    # makes the kubelet chown the volume for the pod.
    podSecurityContext:
      fsGroup: 65532
      fsGroupChangePolicy: OnRootMismatch
    deployment:
      initContainers:
        - name: volume-permissions
          image: busybox:1.36
          command: ["sh", "-c", "touch /data/acme.json && chmod 600 /data/acme.json"]
          volumeMounts:
            - name: data
              mountPath: /data
    # Serve the locally-trusted wildcard as the default certificate (fallback
    # when ACME does not issue; import the CA into your browser to trust it).
    # A full run leaves this out so ACME is actually exercised - a default
    # certificate that matches the host makes Traefik skip the request.
{% if lab_ca_default | default(true) | bool %}
    tlsStore:
      default:
        defaultCertificate:
          secretName: umkim-thin-wildcard
{% endif %}
