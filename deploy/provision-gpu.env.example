# Example GPU-node target. Copy to deploy/provision-gpu.env and replace the
# placeholders with your host, zone and card.
#
#   PROVISION_ENV=deploy/provision-gpu.env ./deploy/provision.sh
#
# A GPU node is a normal single-node install plus three things: a driver on the
# host, `default-runtime` in the k3s config, and the device plugin in the cluster.
# The gpu_node role does all three, gated on `gpu_enabled`, so this file differs
# from provision-single.env.example only in the GPU block and its consequences.
# shellcheck shell=bash

JUMP=linux@198.51.100.10
JUMP_PORT=22
VSSH_KEY=$HOME/.ssh/id_ed25519
VHOST=198.51.100.10
VUSER=linux
REMOTE_WORKDIR=/home/linux/umkim-thin-deploy-gpu
servers="198.51.100.10"

zone=gpu.example.com
portal_host=auth.gpu.example.com
console_host=console.gpu.example.com
base_dn=dc=gpu,dc=example,dc=com
admin_email=admin@gpu.example.com
acme_email=admin@gpu.example.com

pub_web=80
pub_tls=443
pub_wg=51820
web_nodeport=30080
tls_nodeport=30443
git_nodeport=30222
pub_git=2222
wg_port=51820

pod_cidr=10.244.0.0/16
service_cidr=10.43.0.0/16
lab_cidr=192.0.2.0/24

k3s_channel=stable
k3s_version=

# Single node: local-path for config, NFS for the shared media volume. Model
# weights are large, so point the media class at real storage.
storage_backend=""
storage_agent=true
storage_socket=/run/umkim-thin

wg_endpoint=198.51.100.10
wg_direct_endpoint=198.51.100.10:51820
wg_subnet=192.168.170.0/24
wg_server_ip=192.168.170.1

# ACME staging unless this host really is public: HTTP-01 has to reach it from
# the internet, which means working DNS and a forwarded port 80.
acme_staging=true
lab_ca_default=true
public_ip=""

ci_apps="ai"

chart_repos=""

# --- GPU ---
# The role refuses a host without a visible NVIDIA display controller, so a typo
# in this block is an error rather than a silent CPU-only install.
gpu_enabled=true

# "open" is Turing and newer only. Pascal and older need the proprietary module,
# and a pre-Turing card is dropped by later driver branches - so pin one. Two
# cards needing different treatment on one host is the awkward case; the rule is
# that if any card needs proprietary, the whole node uses proprietary.
gpu_driver_flavor=proprietary
gpu_driver_version=580.196.07

# Make ci/ai-check.sh assert the GPU contract on this target (a card is
# requested, the node advertises one, the CUDA image runs) instead of the CPU
# one. Without it the harness correctly reports a GPU request as a failure.
ai_gpu=true

remote_dir=/opt/umkim-thin
state_dir=/etc/umkim-thin
