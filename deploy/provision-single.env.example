# Example single-node target. Copy to deploy/provision.env (or point
# ci/e2e.sh at it) and replace the placeholders with your host and zone.
# shellcheck shell=bash

JUMP=linux@jump.example.com
JUMP_PORT=22
VSSH_KEY=$HOME/.ssh/id_ed25519
VHOST=192.0.2.10
VUSER=linux
REMOTE_WORKDIR=/home/linux/umkim-thin-deploy-single
servers="192.0.2.10"

zone=test.example.com
portal_host=auth.test.example.com
console_host=console.test.example.com
base_dn=dc=test,dc=example,dc=com
admin_email=admin@test.example.com
acme_email=admin@test.example.com

pub_web=80
pub_tls=443
pub_wg=51820
web_nodeport=30080
tls_nodeport=30443
git_nodeport=30222
pub_git=2222
wg_port=51820

pod_cidr=10.244.0.0/16
service_cidr=10.43.0.0/16
lab_cidr=192.0.2.0/24

k3s_channel=stable
k3s_version=

# Single node: local config storage + NFS for shared media (no HA storage).
# The shared class is `umkim-thin-nfs`; an existing cluster can pin
# nfs_storage_class=nfs to keep the old class name.
# The console state is on a local-path PVC; the host storage agent is the only
# host-coupled piece and its socket is mounted into the console pod.
storage_backend=""
storage_agent=true
storage_socket=/run/umkim-thin

# The public address clients dial, and the address the test runner uses when it
# is on the same network as the node. Use the public DNS name (wg.example.com);
# the port is appended unless you include it.
wg_endpoint=
wg_direct_endpoint=192.0.2.10:51820
wg_subnet=192.168.168.0/24
wg_server_ip=192.168.168.1

# Tests must not consume the production ACME limit.
acme_staging=true
# Serve a local-CA wildcard as Traefik's default certificate. A "full" run
# (CI_PROFILE=full) sets this to false so ACME is actually exercised.
lab_ca_default=true
# The address the zone's public A records must point at (the ingress). The
# preflight compares DNS against it; a full run refuses to start without it.
public_ip=""

# Apps to install and verify with Playwright.
ci_apps="gitea nextcloud immich paperless servarr"

# Optional out-of-tree charts, as "url:subdir" or "repo:subdir" pairs. They are
# cloned with the runner's Git credentials and packaged into the chart mirror.
# Leave empty to use the vendored charts under charts/apps/.
chart_repos=""

remote_dir=/opt/umkim-thin
state_dir=/etc/umkim-thin
