# Example three-node HA target. Copy to deploy/provision.env (or point
# ci/e2e.sh at it) and replace the placeholders with your hosts and zone.
# shellcheck shell=bash

# This is the Ansible executor. It can be the first server, provided that host
# has ansible and passwordless SSH to all servers (including itself).
JUMP=linux@jump.example.com
JUMP_PORT=22
VSSH_KEY=$HOME/.ssh/id_ed25519
VHOST=192.0.2.101
VUSER=linux
REMOTE_WORKDIR=/home/linux/umkim-thin-deploy-ha
servers="192.0.2.101 192.0.2.102 192.0.2.103"

# The kube-vip control-plane VIP, which is also the port-forward target.
k3s_control_plane_vip=192.0.2.100

zone=test.ha.example.com
portal_host=auth.test.ha.example.com
console_host=console.test.ha.example.com
base_dn=dc=test,dc=ha,dc=example,dc=com
admin_email=admin@test.ha.example.com
acme_email=admin@test.ha.example.com

pub_web=80
pub_tls=443
pub_wg=51820
web_nodeport=30080
tls_nodeport=30443
git_nodeport=30222
pub_git=2222
wg_port=51820

pod_cidr=10.244.0.0/16
service_cidr=10.43.0.0/16
lab_cidr=192.0.2.0/24

k3s_channel=stable
k3s_version=

# HA: the console runs off the host on a PVC; config is Longhorn RWO
# (`longhorn-rwo`, 2 replicas) and shared media comes from the external NFS
# server. The console has no host storage-agent socket.
# The app charts' bootstrap Jobs affinity to their server pod, so an RWO claim
# shared by both works on Longhorn (whose PVs carry no node affinity).
storage_backend=longhorn
storage_class_config=longhorn-rwo
# External NFS is optional at install time. Until it is added in the console,
# media uses Longhorn's RWX class; add the NFS class later under Storage and
# select it for new app installs. To configure it during provisioning instead,
# uncomment the nfs_* block and change storage_class_media to umkim-thin-nfs.
storage_class_media=longhorn-rwx
nfs_storage_class=umkim-thin-nfs
longhorn_replica_count=3
# Set to 2 on a small lab or when three replicas do not fit.
# longhorn_replica_count=2
# Longhorn is thin: this caps nominal scheduled capacity. Keep 100 on a shared
# root disk; raise to 200 only on a dedicated lab disk with enough real free
# space. 25 is Longhorn's minimum-free guard.
longhorn_storage_over_provisioning_percentage=100
longhorn_storage_minimal_available_percentage=25
# nfs_mode=external
# nfs_server=192.0.2.50
# nfs_export=/srv/nfs/umkim-thin
storage_agent=false
storage_socket=""

# The public/stable endpoint in client configs. With the DaemonSet gateway this
# can be the kube-vip VIP; forward UDP 51820 to the VIP from the provider/NAT.
# Prefer the public DNS name (e.g. wg.example.com) so the endpoint survives a
# VIP or address change; the port is appended unless you include it.
wg_endpoint=192.0.2.100
# CI dials the gateway pod directly from the node network.
wg_direct_endpoint=192.0.2.100:51820
wg_subnet=192.168.169.0/24
wg_server_ip=192.168.169.1

acme_staging=true
# Serve a local-CA wildcard as Traefik's default certificate. A "full" run
# (CI_PROFILE=full) sets this to false so ACME is actually exercised.
lab_ca_default=true
# The address the zone's public A records must point at (the ingress). The
# preflight compares DNS against it; a full run refuses to start without it.
# Optional fixed public/NAT address. Leave blank for dynamic DNS; verify-ha
# accepts the current common public address. Set it only to assert a fixed IP.
public_ip=""
# Apps to install and verify with Playwright (includes OIDC and a multi-route,
# RWX-backed app).
ci_apps="gitea nextcloud immich paperless servarr"

# HA has multiple API servers. k3s generates a per-server encryption key unless
# the config is distributed; enabling it without that breaks Secrets across
# nodes ("failed to sync secret cache", mismatched hashes). Keep it off on HA
# until the key distribution is automated; single-node runs keep it on.
secrets_encryption=false

# Optional out-of-tree charts, as "url:subdir" or "repo:subdir" pairs. They are
# cloned with the runner's Git credentials and packaged into the chart mirror.
# Leave empty to use the vendored charts under charts/apps/.
chart_repos=""

remote_dir=/opt/umkim-thin
state_dir=/etc/umkim-thin
