# GPU lab node (gitignored) — single node, bare metal, on the lab network.
#
# This host used to be a umkim (fleet) member cluster. It was wiped to a clean
# Rocky Linux 10.2 and is now a umkim-thin target. It has the only NVIDIA GPU in
# the lab: a Pascal GTX 1050 Ti Mobile (10de:1c8c), which is why the driver work
# here uses the proprietary, version-pinned branch rather than the open module.
#
#   PROVISION_ENV=deploy/provision-gpu.env ./deploy/provision.sh
#
# It is reached directly (no jumphost hop needed from the agent host), and it has
# no public DNS, so the ingress serves a lab CA and every name must be pinned in
# /etc/hosts on whichever machine talks to it.

JUMP=linux@172.16.10.4
JUMP_PORT=22
VSSH_KEY=/home/linux/.ssh/id_ed25519
VHOST=172.16.10.4
VUSER=linux
REMOTE_WORKDIR=/home/linux/umkim-thin-deploy-gpu
servers="172.16.10.4"

zone=gpu.lab.umkim.com
portal_host=auth.gpu.lab.umkim.com
console_host=console.gpu.lab.umkim.com
base_dn=dc=gpu,dc=lab,dc=umkim,dc=com
admin_email=admin@gpu.lab.umkim.com
acme_email=admin@gpu.lab.umkim.com

pub_web=80
pub_tls=443
pub_wg=51820
web_nodeport=30080
tls_nodeport=30443
git_nodeport=30222
pub_git=2222
wg_port=51820

pod_cidr=10.244.0.0/16
service_cidr=10.43.0.0/16
lab_cidr=172.16.10.0/24

k3s_channel=stable
k3s_version=

# Single node: local-path for config, NFS for the shared media volume. The GPU
# node has 228 GiB free, which is what the model weights need.
storage_backend=""
storage_agent=true
storage_socket=/run/umkim-thin

# No public DNS: the routes get a certificate from the platform's own CA, and
# clients import state_dir/tls/ca.crt.
wg_endpoint=172.16.10.4
wg_direct_endpoint=172.16.10.4:51820
wg_subnet=192.168.170.0/24
wg_server_ip=192.168.170.1

acme_staging=true
lab_ca_default=true
public_ip=""

# Only the apps under active verification, same policy as the other dev targets.
ci_apps="ai vikunja bookstack wireguard"

# This target has the lab's only GPU, so the AI harness asserts the GPU path
# (a card is requested, the node advertises one, the CUDA image runs) instead of
# the CPU-mode check that every other target uses.
ai_gpu=true

chart_repos=""

# Everything the console needs to reach the GPU host agent and the AI stack.
trusted_management_cidrs="172.16.10.0/24"

remote_dir=/opt/umkim-thin
state_dir=/etc/umkim-thin
