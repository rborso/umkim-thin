# dev-single: umkim-hub (the VPS), zone single-dev.umkim.com
JUMP=linux@127.0.0.1
JUMP_PORT=22
VSSH_KEY=/home/linux/.ssh/id_ed25519
VHOST=159.195.137.119
VUSER=linux
REMOTE_WORKDIR=/home/linux/umkim-thin-deploy-dev-single
servers="159.195.137.119"

zone=single-dev.umkim.com
portal_host=auth.single-dev.umkim.com
console_host=console.single-dev.umkim.com
base_dn=dc=single-dev,dc=umkim,dc=com
admin_email=admin@umkim.com
acme_email=admin@umkim.com

pub_web=80
pub_tls=443
pub_wg=51820
web_nodeport=30080
tls_nodeport=30443
git_nodeport=30222
pub_git=2222
wg_port=51820

pod_cidr=10.244.0.0/16
service_cidr=10.43.0.0/16
lab_cidr=159.195.136.0/22

k3s_channel=stable
k3s_version=

storage_backend=""
storage_agent=true
storage_socket=/run/umkim-thin

wg_endpoint=wg.single-dev.umkim.com
wg_direct_endpoint=159.195.137.119:51820
wg_subnet=192.168.168.0/24
wg_server_ip=192.168.168.1

# Dev uses production Let's Encrypt with a persistent certificate cache.
acme_staging=false
lab_ca_default=false
public_ip=159.195.137.119

trusted_access_enabled=true
trusted_management_enabled=true
trusted_management_cidrs="172.16.10.0/24 84.1.215.254/32"
trusted_management_exclude_cidrs=""

# No external backup target on the dev box; the console keeps its own PVC.
backup_nfs=

ci_apps="actualbudget gitea homebox immich mealie nextcloud paperless servarr sparkyfitness wireguard"

chart_repos=""

remote_dir=/opt/umkim-thin
state_dir=/etc/umkim-thin
